case 81:
{
    static uint8_t level[64];
    static uint8_t peak[64];

    for(int x=0;x<64;x++)
    {
        int target=random(0,17);

        if(level[x]<target)
            level[x]+=2;
        else if(level[x]>target)
            level[x]--;

        if(level[x]>15) level[x]=15;

        if(level[x]>peak[x])
            peak[x]=level[x];
        else if(peak[x]>0)
            peak[x]--;

        for(int y=0;y<16;y++)
            pixel(x,y,0,0,0);

        for(int y=0;y<level[x];y++)
        {
            if(y<5)
                pixel(x,15-y,0,255,0);
            else if(y<10)
                pixel(x,15-y,255,255,0);
            else
                pixel(x,15-y,255,0,0);
        }

        pixel(x,15-peak[x],255,255,255);
    }

    delay(speed);
}
break;

  case 82:
{
    static uint8_t level[32];
    static uint8_t peak[32];

    dma_display->clearScreen();

    for(int i=0;i<32;i++)
    {
        int target=random(0,16);

        if(level[i]<target)
            level[i]+=2;
        else if(level[i]>target)
            level[i]--;

        if(level[i]>peak[i])
            peak[i]=level[i];
        else if(peak[i]>0)
            peak[i]--;

        for(int x=i*2;x<i*2+2;x++)
        {
            for(int y=0;y<level[i];y++)
            {
                uint8_t r=0,g=255,b=0;

                if(y>5){r=255;g=255;}
                if(y>10){r=255;g=0;}

                pixel(x,15-y,r,g,b);
            }

            pixel(x,15-peak[i],255,255,255);
        }
    }

    delay(speed);
}
break;

    /*case 88:
    { receiveDDP(); }
    */

    case 99:
      dma_display->drawPixel(truc_x, truc_y, dma_display->color565(color_r, color_g, color_b));
      break;
    
    case 200:
     for(int x=0;x<10;x++)
     {
       drawNumber(truc_x, truc_y, x,color_r,color_g,color_b);     // đếm số 
       delay(speed);
       dma_display->clearScreen();
    }
    break;

    case 201:
    {
      struct tm timeinfo;

      if (getLocalTime(&timeinfo))
      {
          uint8_t hour_i   = timeinfo.tm_hour;
          uint8_t minute_i = timeinfo.tm_min;

          drawNumber(2, 4, hour_i / 10,color_r,color_g,color_b);      // Hàng chục giờ
          drawNumber(8, 4, hour_i % 10,color_r,color_g,color_b);      // Hàng đơn vị giờ

          // Dấu :
          pixel(15, 5,color_r,color_g,color_b);
          pixel(16, 5,color_r,color_g,color_b);
          pixel(15, 6,color_r,color_g,color_b);
          pixel(16, 6,color_r,color_g,color_b);
          pixel(15, 9,color_r,color_g,color_b);
          pixel(16,10,color_r,color_g,color_b);
          pixel(15,10,color_r,color_g,color_b);
          pixel(16, 9,color_r,color_g,color_b);

          drawNumber(19, 4, minute_i / 10,color_r,color_g,color_b);   // Hàng chục phút
          drawNumber(25, 4, minute_i % 10,color_r,color_g,color_b);   // Hàng đơn vị phút
          delay(5000);
          dma_display->clearScreen();
      }
    }    
    break;

    case 202:
        {
            struct tm timeinfo;

            if (getLocalTime(&timeinfo))
            {
                uint8_t hour_i   = timeinfo.tm_hour;
                uint8_t minute_i = timeinfo.tm_min;

                dma_display->clearScreen();

                uint8_t r,g,b;

                gradientColor(2,r,g,b);
                drawNumber(2,4,hour_i/10,r,g,b);

                gradientColor(8,r,g,b);
                drawNumber(8,4,hour_i%10,r,g,b);

                gradientColor(15,r,g,b);
                pixel(15,5,r,g,b);
                pixel(16,5,r,g,b);
                pixel(15,6,r,g,b);
                pixel(16,6,r,g,b);
                pixel(15,9,r,g,b);
                pixel(16,9,r,g,b);
                pixel(15,10,r,g,b);
                pixel(16,10,r,g,b);

                gradientColor(19,r,g,b);
                drawNumber(19,4,minute_i/10,r,g,b);

                gradientColor(25,r,g,b);
                drawNumber(25,4,minute_i%10,r,g,b);

                shift++;          // gradient chạy sang phải
                delay(30);
            }
        }
    break;


    case 203:
        {
            struct tm timeinfo;

            if (getLocalTime(&timeinfo))
            {
                gradientOffset += 5;      // tốc độ chạy màu

                uint8_t hour_i   = timeinfo.tm_hour;
                uint8_t minute_i = timeinfo.tm_min;

                drawNumber2(2, 4, hour_i / 10);
                drawNumber2(8, 4, hour_i % 10);

                // dấu :
                uint8_t r,g,b;

                colorWheel(15*8 + gradientOffset, r,g,b);
                pixel(15,5,r,g,b);
                pixel(15,6,r,g,b);
                pixel(15,9,r,g,b);
                pixel(15,10,r,g,b);

                colorWheel(16*8 + gradientOffset, r,g,b);
                pixel(16,5,r,g,b);
                pixel(16,6,r,g,b);
                pixel(16,9,r,g,b);
                pixel(16,10,r,g,b);

                drawNumber2(19, 4, minute_i /10);
                drawNumber2(25, 4, minute_i % 10);
            }
        }
    break;

    case 204:
        dma_display->clearScreen(); 
        drawNumber2(2,4,5);
        delay(speed);
    break;
    
  }

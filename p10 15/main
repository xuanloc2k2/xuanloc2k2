// NTP
const char* ntpServer = "pool.ntp.org";
const long  gmtOffset_sec = 7 * 3600;   // UTC+7
const int   daylightOffset_sec = 0;

// Biến thời gian
struct tm timeinfo;
uint8_t hour_i = 0;
uint8_t minute_i = 0;


void setup() {

  Serial.begin(9600);
   // Mount SPIFFS



    if (!SPIFFS.begin(true))
    {
        Serial.println("SPIFFS Mount Failed");
        return;
    }

    // Kết nối WiFi
    WiFi.begin(ssid, pass);

    Serial.print("Connecting");

    while (WiFi.status() != WL_CONNECTED)
    {
        delay(500);
        Serial.print(".");
    }

    udp.begin(DDP_PORT);
    Serial.println("DDP Ready");
    Serial.println();
    Serial.print("Connected!");
    Serial.print(" IP: ");
    Serial.println(WiFi.localIP());

        // Trang chủ
        server.on("/", HTTP_GET, [](AsyncWebServerRequest *request)
        {
            request->send(SPIFFS, "/index.html", String(), false, processor);
        });

        // CSS
        server.on("/style.css", HTTP_GET, [](AsyncWebServerRequest *request)
        {
            request->send(SPIFFS, "/style.css", "text/css");
        });
        // JavaScript
        server.on("/java.js", HTTP_GET, [](AsyncWebServerRequest *request)
        {
            request->send(SPIFFS, "/java.js", "application/javascript");
        });
    // Nhận 6 biến
        server.on("/set", HTTP_GET, [](AsyncWebServerRequest *request)
        {
            if (request->hasParam("v1"))
                truc_x = request->getParam("v1")->value().toInt();

            if (request->hasParam("v2"))
                truc_y = request->getParam("v2")->value().toInt();

            if (request->hasParam("v3"))
                color_r = request->getParam("v3")->value().toInt();

            if (request->hasParam("v4"))
                color_g = request->getParam("v4")->value().toInt();

            if (request->hasParam("v5"))
                color_b = request->getParam("v5")->value().toInt();

            if (request->hasParam("v6"))
                mode = request->getParam("v6")->value().toInt();
            
            if (request->hasParam("v7"))
                speed = request->getParam("v7")->value().toInt();
            if (request->hasParam("v8"))
                bright = request->getParam("v8")->value().toInt();
                dma_display->setBrightness8(bright); //0-255
             if (request->hasParam("v9"))
                id = request->getParam("v9")->value().toInt();

            request->send(200, "text/plain", "OK");
   });
   server.begin();
  
  // Module configuration
  HUB75_I2S_CFG mxconfig(
    PANEL_RES_X,   // module width
    PANEL_RES_Y,   // module hei+ght
    PANEL_CHAIN    // Chain length

  );

  //mxconfig.gpio.e = 18;
  //mxconfig.clkphase = false;
  //mxconfig.driver = HUB75_I2S_CFG::FM6126A;
  
  // Display Setup
  dma_display = new MatrixPanel_I2S_DMA(mxconfig);
  dma_display->setBrightness8(20); //0-255
  dma_display->clearScreen();

  myBLACK = dma_display->color565(0, 0, 0);
  myWHITE = dma_display->color565(255, 255, 255);
  myRED = dma_display->color565(255, 0, 0);
  myGREEN = dma_display->color565(0, 255, 0);
  myBLUE = dma_display->color565(0, 0, 255);
  




  dma_display->clearScreen();
  delay(500);
  //drawText(0);
  dma_display->begin();
  dma_display->setBrightness8(bright); //0-255

  // ================= GPIO =================


  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
}

uint16_t rainbow(uint8_t pos)
{
    pos = 255 - pos;

    if (pos < 85)
        return dma_display->color565(255 - pos * 3, 0, pos * 3);

    if (pos < 170)
    {
        pos -= 85;
        return dma_display->color565(0, pos * 3, 255 - pos * 3);
    }

    pos -= 170;
    return dma_display->color565(pos * 3, 255 - pos * 3, 0);
}

void pixel565(int x,int y,uint16_t c)
{
    int yy = y % 4;
    if(y>=8) yy+=4;

    int xx = matrix[(y>>2)&1][x];

    dma_display->drawPixel(xx,yy,c);
}


void drawNumber(uint8_t x, uint8_t y, uint8_t num, uint8_t r, uint8_t g, uint8_t bl)             // vẽ số theo màu biến
{
    for (uint8_t a = 0; a < 5; a++)
    {
        for (uint8_t b = 0; b < 8; b++)
        {
            if (number2[num][a] & (1 << b))
                pixel(x + a, y + b,r,g,bl);
        }
    }
}

void drawFont(uint8_t x, uint8_t y, uint8_t id,
              uint8_t r, uint8_t g, uint8_t b)
{
    for (uint8_t col = 0; col < 5; col++)
    {
        uint16_t data = fontvn[id][col];

        for (uint8_t row = 0; row < 16; row++)
        {
            // bit0 ở bên trái
            if (data & (1U << (15 - row)))
            {
                pixel(x + col, y + row, r, g, b);
            }
        }
    }
}

uint8_t shift = 0;

void gradientColor(uint8_t x, uint8_t &r, uint8_t &g, uint8_t &b)
{
    

    uint8_t p = (x * 8 + shift) & 0xFF;

    if (p < 85)
    {
        r = 255 - p * 3;
        g = p * 3;
        b = 30;
    }
    else if (p < 170)
    {
        p -= 85;
        r = 30;
        g = 255 - p * 3;
        b = p * 3;
    }
    else
    {
        p -= 170;
        r = p * 3;
        g = 30;
        b = 255 - p * 3;
    }
}
 // case 202

uint8_t gradientOffset = 0;

void colorWheel(uint8_t pos, uint8_t &r, uint8_t &g, uint8_t &b)
{
    pos &= 0xFF;

    if (pos < 85)
    {
        r = 255 - pos * 3;
        g = pos * 3;
        b = 0;
    }
    else if (pos < 170)
    {
        pos -= 85;
        r = 0;
        g = 255 - pos * 3;
        b = pos * 3;
    }
    else
    {
        pos -= 170;
        r = pos * 3;
        g = 0;
        b = 255 - pos * 3;
    }
}

void drawNumber2(uint8_t x, uint8_t y, uint8_t num)                                             // vẽ số theo gradient
{
    for (uint8_t i = 0; i < 5; i++)
    {
        uint8_t r,g,b;
        colorWheel((x+i)*8 + gradientOffset, r, g, b);

        for (uint8_t j = 0; j < 8; j++)
        {
            if (number2[num][i] & (1 << (7-j)))
                pixel(x+i, y+j, r, g, b);
        }
    }
}


void loop() {

  switch(mode)
  {
    case 0:
        for(int i=0; i<64; i++){pixel(i, 0, 255, 0, 0);}
        mode = 100;
      break;

    case 1:
      dma_display->clearScreen();
      mode = 100;
      break;
    case 2:
      pixel(truc_x, truc_y, color_r, color_g, color_b);
      break;
    case 3:
      dma_display->clearScreen();        
      drawFont(truc_x,truc_y,id,color_r,color_g,color_b);
      mode = 100;
    break;

    // Khung màn hình
    case 7:
        dma_display->clearScreen();

        for(int x=0;x<64;x++)
        {
            pixel(x,0,color_r,color_g,color_b);
            pixel(x,15,color_r,color_g,color_b);
        }

        for(int y=0;y<16;y++)
        {
            pixel(0,y,color_r,color_g,color_b);
            pixel(63,y,color_r,color_g,color_b);
        }

        mode=100;
        break;

    // Tô kín màn hình
    case 8:
        dma_display->clearScreen();

        for(int y=0;y<16;y++)
        {
            for(int x=0;x<64;x++)
            {
                pixel(x,y,color_r,color_g,color_b);
            }
        }

        mode=100;
        break;

    // Ngẫu nhiên 100 điểm
    case 9:
        dma_display->clearScreen();

        for(int i=0;i<100;i++)
        {
            pixel(random(64),
                  random(16),
                  random(256),
                  random(256),
                  random(256));
        }

        mode=100;
        break;

    // Kim cương lớn
    case 17:

    if(!init)
    {
        for(int i=0;i<64;i++)
            y[i]=random(16);
        init=true;
    }

    dma_display->clearScreen();

    for(int x=0;x<64;x++)
    {
        pixel565(x,y[x],rainbow(x*4+y[x]*10));
        y[x]++;
        if(y[x]>=16)y[x]=0;
    }

    delay(speed);
}

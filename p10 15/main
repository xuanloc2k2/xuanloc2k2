                    pixel(x,y,color_r,color_g,color_b);
            }
        }
        mode=100;
        break;

    // Hình dấu +
    case 20:
        dma_display->clearScreen();
        for(int x=0;x<64;x++)
            pixel(x,8,color_r,color_g,color_b);

        for(int y=0;y<16;y++)
            pixel(32,y,color_r,color_g,color_b);

        mode=100;
        break;

    // Nở hình vuông
    case 21:
        dma_display->clearScreen();
        for(int r=1;r<8;r++)
        {
            for(int x=32-r;x<=32+r;x++)
            {
                pixel(x,8-r,color_r,color_g,color_b);
                pixel(x,8+r,color_r,color_g,color_b);
            }

            for(int y=8-r;y<=8+r;y++)
            {
                pixel(32-r,y,color_r,color_g,color_b);
                pixel(32+r,y,color_r,color_g,color_b);
            }
        }
        mode=100;
        break;

    // Lưới
    case 22:
        dma_display->clearScreen();
        for(int x=0;x<64;x+=4)
            for(int y=0;y<16;y++)
                pixel(x,y,color_r,color_g,color_b);

        for(int y=0;y<16;y+=4)
            for(int x=0;x<64;x++)
                pixel(x,y,color_r,color_g,color_b);

        mode=100;
        break;

    // Pixel ngẫu nhiên toàn màn hình
    case 23:
        dma_display->clearScreen();

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="stylesheet" type="text/css" href="style.css">
<script src="java.js"></script>
<title>ESP32 HUB75</title>


</head>

<body>

<h2>LED P10</h2>

<div class="container">

<input id="x" type="number" min="0" max="63" placeholder="Trục X">
<input id="y" type="number" min="0" max="15" placeholder="Trục Y">
<input id="speed" type="number" min="0" max="1000" placeholder="Tốc độ (ms)">
<input id="bright" type="number" min="0" max="255" placeholder="Độ sáng (0-255)">
<input id="text" type="text" placeholder = "VĂN BẢN">

<input id="rSlider" type="range" min="0" max="255" value="0">
<input id="rNum" type="number" min="0" max="255" placeholder="Red">
<input id="gSlider" type="range" min="0" max="255" value="0">
<input id="gNum" type="number" min="0" max="255" placeholder="Green">
<input id="bSlider" type="range" min="0" max="255" value="0">
<input id="bNum" type="number" min="0" max="255" placeholder="Blue">

<div id="colorPreview"></div>
<label>Mode</label>

<input id="mode" list="modeList" value="2">

<datalist id="modeList">
    <option value="0">Vẽ hàng đầu</option>
    <option value="1">Clear</option>
    <option value="2">Pixel</option>
</datalist>

<button onclick="sendData()">Send</button>
<button onclick="clearDisplay()">Off</button>
<button onclick="drawLine()">Vẽ hàng đầu</button>
<button onclick="drawPixel()">Vẽ Pixel theo tọa độ</button>

</div>

</body>
</html>

body{
    font-family: Arial, Helvetica, sans-serif;
    background:#f4f6f9;
    margin:0;
    padding:30px;
}


/* Thanh Red */
#rSlider{
    width: 100%;
    margin:-10px;
    margin-top: 10px;
    accent-color: #ff0000;
}

/* Thanh Green */
#gSlider{
    margin:-10px;
    margin-top: 10px;
    width: 100%;
    accent-color: #15ff00;
}

/* Thanh Blue */
#bSlider{
    width: 100%;
    accent-color: #00a2ff;
    margin: -10px;
    margin-top: 10px;
}

h2{
    text-align:center;
    color:#ff0000;
}
.container {
    display: grid;

    /* 2 cột bằng nhau */
    grid-template-columns: 1fr 1fr;

    gap: 10px;

    width: 600px;
    margin: auto;
}


.container input,
.container button,
.container label,
#colorPreview {
    width: 100%;
    box-sizing: border-box;
}


input{
    padding:10px 12px;
    border:2px solid #cfcfcf;
    border-radius:8px;
    font-size:16px;
    outline:none;
    transition:0.25s;
}

#rNum:focus{
    border-color:#ff0000;
    box-shadow:0 0 8px rgba(33,150,243,.35);
}

#gNum:focus{
    border-color:#00ff62;
    box-shadow:0 0 8px rgba(33,150,243,.35);
}

#bNum:focus{
    border-color:#1100ff;
    box-shadow:0 0 8px rgba(33,150,243,.35);
}

#text:focus{
    border-color:#000000;
    box-shadow:0 0 8px rgba(0, 0, 0, 0.35);
}

/* ===== BUTTON ===== */

button{
    padding:12px;
    font-size:16px;
    font-weight:bold;
    border:2px solid #1976D2;
    border-radius:10px;
    background:white;
    color:#1976D2;
    cursor:pointer;
    transition:all .25s ease;
}

/* Hover */
button:hover{
    background:#1976D2;
    color:white;
    transform:translateY(-2px);
    box-shadow:0 6px 15px rgba(25,118,210,.35);
}

/* Khi nhấn */
button:active{
    transform:scale(.96);
    box-shadow:none;
}

/* Nút đầu tiên */
button:nth-of-type(1){
    border-color:#4CAF50;
    color:#4CAF50;
}

button:nth-of-type(1):hover{
    background:#4CAF50;
    color:white;
}

/* Nút xóa */
button:nth-of-type(2){
    border-color:#F44336;
    color:#F44336;
}

button:nth-of-type(2):hover{
    background:#F44336;
    color:white;
}

/* Vẽ hàng */
button:nth-of-type(3){
    border-color:#FF9800;
    color:#FF9800;
}

button:nth-of-type(3):hover{
    background:#FF9800;
    color:white;
}

/* Pixel */
button:nth-of-type(4){
    border-color:#9C27B0;
    color:#9C27B0;
}

button:nth-of-type(4):hover{
    background:#9C27B0;
    color:white;
}
